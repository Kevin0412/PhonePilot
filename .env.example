# 复制为 .env（已被 .gitignore 忽略）。只填用到的。密钥只走环境变量。

# 文本 LLM
DEEPSEEK_API_KEY=      # 也可用 DeepSeek 的 Anthropic 兼容端点联调 claude：
                       #   --llm claude --llm-base-url https://api.deepseek.com/anthropic
                       #   --llm-model deepseek-v4-flash --llm-env-key DEEPSEEK_API_KEY
ANTHROPIC_API_KEY=

# OpenAI 兼容文本 / 视觉多模态（OCR 兜底）—— 按所选 provider 填一个
MIMO_API_KEY=          # MiMo (小米)  文本: --llm openai --llm-provider mimo (mimo-v2.5)
DASHSCOPE_API_KEY=     # Qwen / Qwen-VL (阿里 DashScope)
GLM_API_KEY=           # GLM / GLM-4V (智谱)
MOONSHOT_API_KEY=      # Kimi (Moonshot)
