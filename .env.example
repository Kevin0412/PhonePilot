# 复制为 .env（已被 .gitignore 忽略）。只填用到的。密钥只走环境变量。
# 注意：值后面不要写行内注释，把注释单独放一行（否则可能被当成值）。

# 文本 LLM
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# DeepSeek 也提供 Anthropic 兼容端点，可用来联调 claude 代码路径：
#   --llm claude --llm-base-url https://api.deepseek.com/anthropic
#   --llm-model deepseek-v4-flash --llm-env-key DEEPSEEK_API_KEY

# OpenAI 兼容文本 / 视觉多模态 —— 按所选 provider 填一个
# MiMo (小米)  文本: --llm openai --llm-provider mimo
MIMO_API_KEY=
# Qwen / Qwen-VL (阿里 DashScope)
DASHSCOPE_API_KEY=
# GLM / GLM-4V (智谱)
GLM_API_KEY=
# Kimi (Moonshot)
MOONSHOT_API_KEY=
